| genus = '''''Cynomys'''''
| genus_authority = [[Constantine S. Rafinesque-Schmaltz|Rafinesque]], 1817
| subdivision_ranks = Species
| subdivision = 
''[[Cynomys gunnisoni]]''&lt;br /&gt;
''[[Cynomys leucurus]]''&lt;br /&gt;
