[[fr:Confession d'Augsbourg]]
[[it:Confessione augustana]]
[[nl:Confessio Augustana]]
[[ja:&amp;#12450;&amp;#12454;&amp;#12464;&amp;#12473;&amp;#12502;&amp;#12523;&amp;#12463;&amp;#20449;&amp;#20208;&amp;#21578;&amp;#30333;]]
