      <text xml:space="preserve">{| border=&quot;0&quot; cellpadding=&quot;2&quot; cellspacing=&quot;1&quot; align=&quot;right&quot; style=&quot;margin-left:1em; background:#e3e3e3;&quot;
|-
! [[Coat of Arms]]
|----- bgcolor=&quot;#FFFFFF&quot;
| align=&quot;center&quot; | [[Image:Khabarovsk gerb.gif|150px]]
|-
|----- bgcolor=&quot;#FFFFFF&quot;
