[[he:&amp;#1490;&amp;#1488;&amp;#1493;&amp;#1490;&amp;#1512;&amp;#1508;&amp;#1497;&amp;#1492; &amp;#1513;&amp;#1500; &amp;#1511;&amp;#1496;&amp;#1488;&amp;#1512;]]</text>
