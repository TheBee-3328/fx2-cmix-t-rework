  <page>
    <title>Quantum physics</title>
    <id>25178</id>
    <revision>
      <id>15921848</id>
      <timestamp>2002-10-25T06:59:55Z</timestamp>
      <contributor>
        <username>The Anome</username>
        <id>76</id>
      </contributor>
      <comment>redir</comment>
