  | area = 46,766.45 acres&lt;font size=&quot;-2&quot;&gt;&lt;br&gt;&amp;nbsp; (46,427.26 federal)&lt;/font&gt;&lt;br&gt;189.26 km²
  | established = [[May 14]], [[1930]]
  | visitation_num = 419,599
