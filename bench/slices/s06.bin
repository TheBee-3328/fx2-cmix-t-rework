[[de:Uxmal]]
[[es:Uxmal]]
[[fr:Uxmal]]
[[gl:Uxmal]]
[[nl:Uxmal]]
[[ja:ウシュマル]]
[[pl:Uxmal]]
[[pt:Uxmal]]
[[fi:Uxmal]]</text>
    </revision>
