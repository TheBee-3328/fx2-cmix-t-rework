      <text xml:space="preserve">{{Infobox_Kommune|
name=Porsgrunn|
county=[[Telemark]]|
idnumber=0805|
landscape=[[Grenland]]|
capital=Porsgrunn|
governor=Øystein Beyer ([[Arbeiderpartiet|Ap]])|
governor_as_of=2003|
arearank=352|
area=165|
arealand=161|
areapercent=0.05|
population_as_of=2005|
