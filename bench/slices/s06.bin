      <text xml:space="preserve">{{infobox London place|
   |Place=             West Norwood
   |Borough=           [[London Borough of Lambeth|Lambeth]]
   |Traditional=       [[Kent]]
   |Constituency=      
   |PostTown=          LONDON
   |PostCode=          [[London SE27|SE27]]
   |DiallingCode=      020
   |GridReference=     TQ325715
   |GLA=               [[Lambeth and Southwark]]
