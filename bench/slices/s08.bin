      </contributor>
      <minor />
      <comment>/* References */</comment>
      <text xml:space="preserve">{{Infobox Military Conflict
|conflict=Battle of Trenton|
        image=[[Image:washington-crossing-delaware.jpg|300px|]]|
      caption=''[[Washington Crossing the Delaware]]'' by [[Emanuel Gottlieb Leutze]]|
     partof=[[Revolutionary War]]|
         date=[[December 26]], [[1776]]|   combatant2=[[United Kingdom|Britain]]|
   place=[[Trenton]], [[New Jersey]]|
   result=Revolutionary victory|

   commander1=[[George Washington]]|
   commander2=[[Johan Rall]]|
    strength1=2,400|
    strength2=1,400|
  casualties1=4 wounded|
  casualties2=22 dead, 92 wounded&lt;br&gt;913 captured|
