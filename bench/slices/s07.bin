    <title>He-Man</title>
    <id>199822</id>
    <restrictions>edit=autoconfirmed:move=autoconfirmed</restrictions>
    <revision>
      <id>41623976</id>
      <timestamp>2006-02-28T16:26:40Z</timestamp>
      <contributor>
        <username>ClockworkSoul</username>
        <id>137964</id>
