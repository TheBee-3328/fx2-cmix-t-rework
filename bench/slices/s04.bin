  | coordinates = {{coor dms|15|48|59|S|129|08|23|E|type:landmark_region:AU}}
  | area = 568.89 km²
  | established = 1991
  | visitation_num = 
  | visitation_year = 
  | managing_authorities = Parks and Wildlife Commission of the Northern Territory
  | official_site = [http://www.nt.gov.au/ipe/conmgt/index.cfm?fuseaction=viewPark&amp;page=1&amp;menu=ParkRes&amp;pid=93 Keep River National Park]
